# Local development defaults. Do not use the development secret in production.
APP_NAME=AI Personal Stylist API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Security: replace with a securely generated value before production deployment.
SECRET_KEY=development-only-change-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# Uploads
MAX_UPLOAD_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# External services
OPENWEATHERMAP_API_KEY=your-openweathermap-key

# Rate limiting
UPLOAD_RATE_LIMIT=6/minute

# Storage
STORAGE_ROOT=./uploads